# Copy to .env and fill in. If .env is missing, the server creates one with random secrets on first start.
PORT=3000
# At least 32 random characters each. Never reuse the values from another installation.
JWT_SECRET=
APP_SECRET=
ADMIN_USER=admin
# Minimum 10 characters; used to create the admin account on first start. Change it later in Admin → Settings.
ADMIN_PASSWORD=
# Google AI Studio key (or set it later in Admin → Settings, where it is stored encrypted)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Set to true when serving over HTTPS (required in production)
SECURE_COOKIES=false
# Set to 1 when running behind a reverse proxy (nginx, Render, etc.)
TRUST_PROXY=0
